# Default server configuration
#
server {
	listen 80 default_server;
	listen [::]:80 default_server;

	server_name _;

	location / {
                proxy_set_header  X-Real-IP  $remote_addr;                                                      
		proxy_pass http://127.0.0.1:8000;
	}

	location /downloader {
		proxy_set_header  X-Real-IP $remote_addr;
		proxy_pass http://127.0.0.1:1234;
	}

	location /feed {
		proxy_set_header  X-Real-IP $remote_addr;
        	proxy_pass http://127.0.0.1:1234;
	}
	location /feed1 {
		proxy_set_header  X-Real-IP $remote_addr;
        	proxy_pass http://127.0.0.1:1234;
	}

	# RSS Finder (feed discovery) runs as the `rssfinder` compose service on
	# port 3001. Same-origin redirect keeps the UI link portable.
	location = /finder {
		return 302 $scheme://$host:3001/;
	}
}
