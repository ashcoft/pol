# Copy to .env and change these values before a production deployment.
# Pin a release tag published after the host-nginx layout change.
POL_VERSION=latest
# always = pull GHCR; never = use a locally built image.
# POL_PULL_POLICY=always
DB_NAME=pol
DB_USER=pol
DB_PASSWORD=change-me

TIME_ZONE=UTC
DEBUG=False
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Captcha for the RSS check and login. CAPTCHA_TEST_MODE disables verification
# and must never be enabled in production.
# CAPTCHA_LENGTH=5
# CAPTCHA_TIMEOUT=5
