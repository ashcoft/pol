# Copy to .env and change these values before a production deployment.
# Pin a release tag published after the host-nginx layout change.
POL_VERSION=latest
# always = pull GHCR; never = use a locally built image.
# POL_PULL_POLICY=always
DB_NAME=pol
DB_USER=pol
DB_PASSWORD=change-me

TIME_ZONE=UTC
DEBUG=False
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Altcha proof-of-work captcha for the RSS check and login. ALTCHA_HMAC_KEY
# defaults to SECRET_KEY; set a separate value in production.
# ALTCHA_ALGORITHM=PBKDF2/SHA-256
# ALTCHA_COST=10000
# ALTCHA_TIMEOUT=1200
