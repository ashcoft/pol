# Copy to .env and change these values before a production deployment.
# Pin a release tag published after the host-nginx layout change.
POL_VERSION=latest
# always = pull GHCR; never = use a locally built image.
# POL_PULL_POLICY=always
DB_NAME=pol
DB_USER=pol
DB_PASSWORD=change-me

TIME_ZONE=UTC
DEBUG=False
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Cap captcha (self-hosted capd + Valkey). CAP_PUBLIC_URL is the
# browser-facing capd origin; create a site key in the capd dashboard and set
# CAP_SITE_KEY / CAP_SECRET from it.
CAP_ADMIN_KEY=change-me-cap-admin
# CAP_PUBLIC_URL=https://cap.example.com
# CAP_SITE_KEY=
# CAP_SECRET=
