# Hosts allowed to serve the app. Loopback only by default; set ALLOWED_HOSTS
# to a comma-separated list of the names or IPs you actually use (for example
# "192.168.0.10" or "feeds.example.com") when serving on another address.
ALLOWED_HOSTS = [host.strip() for host in
                 os.environ.get('ALLOWED_HOSTS', 'localhost,127.0.0.1,[::1]').split(',')
                 if host.strip()]

# The container health check calls http://127.0.0.1:8000/. Keep loopback
# allowed even when ALLOWED_HOSTS is set to the public domain only.
for _loopback_host in ('127.0.0.1', 'localhost'):
    if _loopback_host not in ALLOWED_HOSTS:
        ALLOWED_HOSTS.append(_loopback_host)

# HTTPS sites behind a reverse proxy need their public origin here for POSTs.
